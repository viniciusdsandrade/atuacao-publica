# Copie para .env e preencha. O arquivo .env é ignorado pelo git.
# O ETL lê só variáveis de ambiente; nenhum valor fica no código.

# URL pública do repositório, usada no User-Agent (formato nome/versão (+URL)).
# No GitHub Actions o ETL monta a URL sozinho a partir de GITHUB_SERVER_URL e GITHUB_REPOSITORY.
ETL_REPO_URL=https://exemplo.invalid/repositorio

# Pasta raiz dos dados (raw, normalizado, publicado). Padrão: data, relativa à raiz do repositório.
ETL_DADOS=data

# Requisições simultâneas por fonte. Padrão: 2.
ETL_CONCORRENCIA=2

# Chave da API do Portal da Transparência (fase 2). Obtida em
# https://api.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_CHAVE=
