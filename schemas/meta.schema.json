{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cursor de fonte (_meta/{fonte}.json)",
  "type": "object",
  "required": ["fonte", "status", "ultima_execucao", "ultima_coleta_ok", "periodo", "contagens", "arquivos", "erros"],
  "properties": {
    "fonte": { "type": "string", "pattern": "^[a-z]+$" },
    "status": { "enum": ["ok", "parcial", "falha", "nao_executada"] },
    "ultima_execucao": { "anyOf": [{ "$ref": "comum.schema.json#/$defs/instante" }, { "type": "null" }] },
    "ultima_coleta_ok": { "anyOf": [{ "$ref": "comum.schema.json#/$defs/instante" }, { "type": "null" }] },
    "periodo": {
      "description": "Último período coberto pela coleta.",
      "anyOf": [
        {
          "type": "object",
          "required": ["inicio", "fim"],
          "properties": {
            "inicio": { "$ref": "comum.schema.json#/$defs/data" },
            "fim": { "$ref": "comum.schema.json#/$defs/data" }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "contagens": {
      "type": "object",
      "additionalProperties": { "$ref": "comum.schema.json#/$defs/contagem" }
    },
    "arquivos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "caminho", "sha256", "bytes", "capturado_em"],
        "properties": {
          "url": { "$ref": "comum.schema.json#/$defs/url" },
          "caminho": { "type": "string", "pattern": "^raw/[^\\s]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "$ref": "comum.schema.json#/$defs/contagem" },
          "capturado_em": { "$ref": "comum.schema.json#/$defs/instante" }
        },
        "additionalProperties": false
      }
    },
    "erros": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
