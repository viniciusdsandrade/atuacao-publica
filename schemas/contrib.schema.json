{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arquivo de contribuição (contrib/{esfera}/{cargo}/{politico_id}/{tipo}.yaml)",
  "description": "Lista de entradas manuais. Cada entrada tem fonte da allowlist, URL de origem e snapshot.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/entrada" },
  "$defs": {
    "entrada": {
      "type": "object",
      "allOf": [
        { "$ref": "comum.schema.json#/$defs/proveniencia_manual" },
        { "$ref": "registros.schema.json#/$defs/texto_ou_resumo" },
        {
          "if": { "properties": { "tipo": { "const": "posicionamento_declarado" } } },
          "then": { "required": ["categoria"] }
        },
        {
          "if": { "properties": { "tipo": { "const": "link_oficial" } } },
          "then": { "required": ["rotulo"] }
        },
        {
          "if": { "properties": { "tipo": { "const": "mandato" } } },
          "then": { "required": ["cargo", "inicio", "fim", "situacao"] }
        }
      ],
      "required": ["tipo", "data"],
      "properties": {
        "tipo": { "enum": ["posicionamento_declarado", "agenda_oficial", "link_oficial", "mandato"] },
        "data": { "description": "Data do fato.", "$ref": "comum.schema.json#/$defs/data" },
        "texto_oficial": { "type": ["string", "null"], "maxLength": 2000 },
        "categoria": { "enum": ["posicionamento", "proposta", "fala_oficial"] },
        "hora": { "anyOf": [{ "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" }, { "type": "null" }] },
        "local": { "$ref": "comum.schema.json#/$defs/texto_ou_nulo" },
        "rotulo": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cargo": { "$ref": "comum.schema.json#/$defs/cargo" },
        "inicio": { "$ref": "comum.schema.json#/$defs/data_ou_nulo" },
        "fim": { "$ref": "comum.schema.json#/$defs/data_ou_nulo" },
        "situacao": { "$ref": "comum.schema.json#/$defs/texto" }
      },
      "unevaluatedProperties": false
    }
  }
}
